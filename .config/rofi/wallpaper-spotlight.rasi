/* Wallpaper Grid - solid, clean, matching the quickshell UI */
/* Only overrides layout/sizing; colors come from the main theme */

@import "~/.config/rofi/config.rasi"

configuration {
    modi: "drun";
    show-icons: true;
    disable-history: true;
    no-custom: true;
    fixed-num-lines: false;
    hover-select: true;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
}

window {
    width: 70%;
    height: 75%;
    location: center;
    anchor: center;
    border: 2px;
    border-radius: 18px;
    padding: 20px;
    background-color: @background;
    text-color: @foreground;
}

mainbox {
    children: [ "inputbar", "listview" ];
    spacing: 14px;
    background-color: transparent;
}

inputbar {
    children: [ entry ];
    spacing: 0;
    padding: 12px 16px;
    border-radius: 14px;
    border: 1px;
    border-color: @border-color;
    background-color: @alternate-background;
}

prompt { enabled: false; }

entry {
    font: "Inter 16";
    placeholder: "Search wallpapers...";
    placeholder-color: @foreground;
    expand: true;
    vertical-align: 0.5;
    cursor: text;
    background-color: transparent;
    text-color: @foreground;
}

listview {
    columns: 5;
    lines: 3;
    spacing: 14px;
    padding: 6px;
    fixed-width: true;
    fixed-height: true;
    flow: horizontal;
    cycle: true;
    background-color: transparent;
}

element {
    orientation: vertical;
    padding: 6px;
    margin: 3px;
    border-radius: 12px;
    border: 2px;
    border-color: transparent;
    spacing: 6px;
    background-color: transparent;
}

element selected.normal {
    background-color: @selected;
    border-color: @active;
    text-color: @background;
}

element selected.active {
    background-color: @selected;
    border-color: @active;
    text-color: @background;
}

element selected.urgent {
    background-color: @urgent;
    border-color: @selected;
    text-color: @background;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element-icon {
    size: 150px;
    horizontal-align: 0.5;
    border-radius: 8px;
    background-color: transparent;
}

element-text {
    font: "Inter 12";
    horizontal-align: 0.5;
    vertical-align: 0.5;
    margin: 4px 0 0 0;
    background-color: transparent;
    text-color: inherit;
}

scrollbar {
    width: 0px;
    background-color: transparent;
}
