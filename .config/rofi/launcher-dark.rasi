/* Dark app launcher */
@import "~/.config/rofi/wallust/colors-rofi.rasi"

configuration {
    modi: "drun,run,filebrowser,window";
    show-icons: true;
    disable-history: false;
    hover-select: true;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
    drun-display-format: "{name}";
    window-format: "{w} · {c} · {t}";
    cycle: true;
}

window {
    width: 55%;
    height: 60%;
    location: center;
    anchor: center;
    border: 2px;
    border-color: @border-color;
    border-radius: 24px;
    background-color: rgba(13, 13, 18, 0.95);
    padding: 24px;
    transparency: "real";
}

mainbox {
    orientation: vertical;
    children: [ "inputbar", "listview" ];
    spacing: 18px;
    background-color: transparent;
}

inputbar {
    orientation: horizontal;
    children: [ prompt, entry ];
    spacing: 12px;
    padding: 12px 16px;
    border-radius: 16px;
    background-color: rgba(30, 30, 40, 0.9);
    border: 1px;
    border-color: rgba(115, 75, 185, 0.5);
}

prompt {
    font: "JetBrainsMono Nerd Font 18";
    text-color: @foreground;
    padding: 0 8px 0 0;
    vertical-align: 0.5;
}

entry {
    font: "Inter 16";
    text-color: @foreground;
    placeholder: "Search apps, files, windows...";
    placeholder-color: #888899;
    expand: true;
    vertical-align: 0.5;
    cursor: text;
}

listview {
    columns: 4;
    lines: 4;
    spacing: 14px;
    padding: 8px;
    fixed-width: true;
    fixed-height: true;
    background-color: transparent;
    flow: horizontal;
    cycle: true;
}

element {
    orientation: vertical;
    padding: 12px;
    margin: 4px;
    border-radius: 14px;
    background-color: rgba(30, 30, 40, 0.7);
    border: 2px;
    border-color: transparent;
    spacing: 8px;
}

element selected.normal {
    background-color: @selected-active-background;
    border-color: @selected-active-background;
}

element selected.active {
    background-color: @active-background;
    border-color: @active-background;
}

element-icon {
    size: 48px;
    horizontal-align: 0.5;
    background-color: transparent;
}

element-text {
    font: "Inter 14";
    text-color: @foreground;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
}

scrollbar {
    width: 0px;
    background-color: transparent;
}

mode-switcher {
    enabled: false;
}
