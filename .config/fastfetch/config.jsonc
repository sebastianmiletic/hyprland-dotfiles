            "keys": "magenta",
            "output": "white",
            "separator": "bright_magenta"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "de",
        "wm",
        "memory",
        "swap",
        "disk",
        "battery",
        "separator",
        "colors"
    ]
}
